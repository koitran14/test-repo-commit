# ============================================================
# Quotation Agent - Environment variables (SECRETS)
# Copy sang .env va dien gia tri. KHONG commit file .env.
# Tren production, platform tu inject cac bien nay.
# ============================================================

# Claude API key (platform-provided)
ANTHROPIC_API_KEY=

# Google OAuth 2.0 (user account) - xem SETUP-GOOGLE.md
# Tao OAuth Client (loai "Desktop app") trong Google Cloud, roi chay:
#   node scripts/get-refresh-token.js
# de lay refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Dashboard (dang nhap Google) ---
# Tao MOT OAuth Client loai "Web application" trong Google Cloud, voi
# Authorized redirect URI = <DASHBOARD_BASE_URL>/auth/google/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Chuoi bi mat de ky cookie phien dang nhap (tu dat, cang dai cang tot)
DASHBOARD_SESSION_SECRET=
# Dia chi goc cua dashboard (local: http://localhost:3100)
DASHBOARD_BASE_URL=http://localhost:3100

# (Tuy chon) Ghi de port
# PORT=3100
